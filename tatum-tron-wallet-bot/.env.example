# Telegram
TELEGRAM_BOT_TOKEN=123456:YOUR_BOT_TOKEN

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tatum_tron_wallet

# Tatum free API key (use Testnet key for testnet first)
TATUM_API_KEY=YOUR_TATUM_API_KEY
TATUM_BASE_URL=https://api.tatum.io

# Use shasta with a Tatum TESTNET API key during development.
# Use mainnet only after you configure proper KMS signing.
TRON_NETWORK=shasta

# Copy these from scripts/bootstrap_wallet.py output.
TRON_MNEMONIC=
TRON_XPUB=

TREASURY_INDEX=0
USER_INDEX_START=1

# Leave empty for TRX-only Shasta testing. Add a testnet TRC20 contract only after verifying it belongs to Shasta.
USDT_TRC20_CONTRACT=
USDT_DECIMALS=6

# Free-plan-friendly deposit scanner
DEPOSIT_SCAN_INTERVAL_SECONDS=180
DEPOSIT_SCAN_BATCH=25
DEPOSIT_LOOKBACK_HOURS=24

# Fees and swap rate. $0.50 is fixed; TRX equivalent uses TRX_USDT_RATE.
SERVICE_FEE_USD=0.50
TRX_USDT_RATE=0.20
USDT_NETWORK_FEE_ESTIMATE=0.35
TRX_NETWORK_FEE_ESTIMATE=1.00
FEE_RESERVE_MULTIPLIER=1.10

# Keep false until Tatum KMS is configured for mainnet.
ALLOW_MAINNET_PRIVATE_KEY_SIGNING=false

# Comma-separated Telegram numeric admin IDs
ADMIN_IDS=123456789
BOT_DISPLAY_NAME=Crypto Wallet

# Optional add-to-group link. Example: https://t.me/your_bot?startgroup=true
ADD_TO_GROUP_URL=
